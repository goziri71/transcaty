# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# LOG_LEVEL=info      # set to debug for noisier Fastify / request internals
APP_BASE_URL=http://localhost:3000  # Base URL for Payok webhooks (use your Render URL in prod)

# Browser dashboards calling this API from another origin need CORS. If missing, OPTIONS preflight → 404 and login looks like "something went wrong".
# Comma-separated SPA origins (scheme+host+port, no path). Defaults include localhost + transacty-admin.vercel.app + admin/dashboard.transacty.ai + any https://*.transacty.ai host.
# Add non-transacty origins here (e.g. Vercel preview): CORS_ALLOWED_ORIGINS=https://merchant-preview.vercel.app

# Encryption (required when using *_ENC vars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# PostgreSQL (Drizzle + pg-boss)
# Option A: Plain (dev only - never commit)
# DATABASE_URL=postgresql://user:password@localhost:5432/transacty

# Option B: Encrypted (production - encrypt with: npm run encrypt -- "postgresql://...")
# DATABASE_URL_ENC=
# ENCRYPTION_MASTER_KEY=   # required to decrypt *_ENC vars

# Use ONE active connection style. If DATABASE_URL_ENC is set, leave plain DATABASE_URL unset
# (or comment it out) unless it is your real connection string — otherwise scripts may hit localhost.

# Verify before migrate: npm run db:check

# API key for protected routes (X-API-Key or Authorization: Bearer)
# If unset, auth is disabled (dev only)
# API_KEY=
# API_KEY_ENC=  # encrypted with: npm run encrypt -- "your-secret-key"

# Provider admin API key (/provider/*)
# PROVIDER_API_KEY=
# PROVIDER_API_KEY_ENC=  # encrypted with: npm run encrypt -- "your-provider-admin-key"
# PROVIDER_JWT_SECRET=   # optional; falls back to PORTAL_JWT_SECRET/JWT_SECRET
# PROVIDER_IP_ALLOWLIST=1.2.3.4,5.6.7.8  # optional: restrict /provider/* by IP
# PROVIDER_APPROVAL_THRESHOLD_AMOUNT=10000 # high-risk amount threshold for maker-checker

# Portal JWT (merchant dashboard login)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PORTAL_JWT_SECRET=
# PORTAL_JWT_EXPIRES_IN=12h   # session TTL (default 12h; was 7d)
# PORTAL_MFA_REQUIRED=true    # when true, block /portal/me/* until MFA enrolled (except /portal/me/mfa/*)
# ALLOW_HTTP_WEBHOOKS=true    # dev only: allow http:// webhook URLs (ignored in production)

# Public URLs for password-reset email links (merchant vs API host)
# PORTAL_PUBLIC_URL = merchant dashboard SPA origin (e.g. https://dashboard.example.com) — NOT the API URL
# PROVIDER_PUBLIC_URL = provider admin SPA origin (e.g. https://admin.transacty.ai) — NOT the API URL
# PORTAL_PUBLIC_URL=https://dashboard.example.com
# PROVIDER_PUBLIC_URL=https://admin.example.com

# Email (transactional: password reset). Set EMAIL_FROM + one provider:
# Plain or encrypted (_ENC): EMAIL_FROM; and ZEPTOMAIL_TOKEN, RESEND_API_KEY, or SMTP_*
# ZeptoMail (Zoho): ZEPTOMAIL_TOKEN=Zoho-enczapikey xxx ; ZEPTOMAIL_URL defaults to https://api.zeptomail.com/
# Resend: RESEND_API_KEY=re_xxx
# Or SMTP: SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS=
# EMAIL_APP_NAME=Transacty

# Optional Redis (distributed rate limits for forgot/reset; /health reports redis status)
# Plain or encrypted: REDIS_URL or REDIS_URL_ENC
# REDIS_URL=redis://default:password@host:6379
# REDIS_CONNECT_TIMEOUT_MS=3000   # optional; default 3000 (ioredis default is 10000 — slow /health when Redis is unreachable)
# REDIS_MAX_RECONNECT_ATTEMPTS=15 # optional; give up after N reconnect tries (stops log spam / long hangs for a bad URL)

# Password reset token TTL and rate limits
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# PASSWORD_RESET_REQUESTS_PER_IP_PER_HOUR=5
# PASSWORD_RESET_ATTEMPTS_PER_IP_PER_HOUR=30

# TOTP MFA (portal + provider) — requires ENCRYPTION_MASTER_KEY to store secrets
# PORTAL_MFA_ISSUER=Transacty Portal
# PROVIDER_MFA_ISSUER=Transacty Provider

# Prometheus metrics (APM-style).
# Production: set METRICS_TOKEN on Render, or leave unset so GET /metrics returns 404.
# When set, clients must send: Authorization: Bearer <METRICS_TOKEN>
# METRICS_TOKEN=

# Tylt India internal transfer (POST /v1/internal-transfer) — required or API returns 503 payment_unavailable.
# JSON array of directed [fromUUID, toUUID] pairs from Tylt getMerchantDetails.
# TYLT_TEST_INTERNAL_TRANSFER_PAIR_ALLOWLIST=[["uuid-from","uuid-to"]]
# TYLT_LIVE_INTERNAL_TRANSFER_PAIR_ALLOWLIST=[["uuid-from","uuid-to"]]
# TYLT_INTERNAL_TRANSFER_PAIR_ALLOWLIST=  # shared fallback (or *_ENC)

# Payok (plain or *_ENC)
# PAYOK_MERCHANT_ID=
# PAYOK_MERCHANT_ID_ENC=
# PAYOK_MERCHANT_PRI_KEY=   # RSA private key PEM
# PAYOK_MERCHANT_PRI_KEY_ENC=
# PAYOK_BASE_URL=           # Production: https://api.payok.xxx
# PAYOK_BASE_URL_ENC=
# PAYOK_PLATFORM_PUB_KEY=   # Payok public key for verifying callbacks
# PAYOK_PLATFORM_PUB_KEY_ENC=
# PAYOK_DEFAULT_ENV=live    # live | test (used if tx metadata has no env)
#
# Recommended split env (supports sandbox + live merchants together):
# PAYOK_TEST_MERCHANT_ID=
# PAYOK_TEST_MERCHANT_ID_ENC=
# PAYOK_TEST_MERCHANT_PRI_KEY=
# PAYOK_TEST_MERCHANT_PRI_KEY_ENC=
# PAYOK_TEST_BASE_URL=      # Sandbox URL
# PAYOK_TEST_BASE_URL_ENC=
# PAYOK_TEST_PLATFORM_PUB_KEY=
# PAYOK_TEST_PLATFORM_PUB_KEY_ENC=
#
# PAYOK_LIVE_MERCHANT_ID=
# PAYOK_LIVE_MERCHANT_ID_ENC=
# PAYOK_LIVE_MERCHANT_PRI_KEY=
# PAYOK_LIVE_MERCHANT_PRI_KEY_ENC=
# PAYOK_LIVE_BASE_URL=      # Live URL
# PAYOK_LIVE_BASE_URL_ENC=
# PAYOK_LIVE_PLATFORM_PUB_KEY=
# PAYOK_LIVE_PLATFORM_PUB_KEY_ENC=
# APP_BASE_URL must be a public URL Payok can reach for webhooks (Render URL in prod, ngrok for local)
# KYC_REQUIRED=true  # When set, pay-in/payout require merchants.kyc_status=verified

# Outbound payment processor circuit (separate state per rail).
# Opens after consecutive failures (network errors or HTTP >= 500), then short-circuits with a generic merchant response.
# PROVIDER_CIRCUIT_ENABLED=true
# PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
# PROVIDER_CIRCUIT_COOLDOWN_MS=60000
# Optional per rail (fallback to globals above):
# PROVIDER_CIRCUIT_PAYOK_FAILURE_THRESHOLD=
# PROVIDER_CIRCUIT_PAYOK_COOLDOWN_MS=
# PROVIDER_CIRCUIT_TYLT_FAILURE_THRESHOLD=
# PROVIDER_CIRCUIT_TYLT_COOLDOWN_MS=

# Tylt — TL Pay issues separate API keys per product. Recommended: lane-specific vars
# (India vs EU), each with pay-in and pay-out. Falls back to TYLT_{TEST|LIVE}_{PAYIN|PAYOUT}_*
# then legacy TYLT_{TEST|LIVE}_* / TYLT_*.
#
# India (UPI H2H, CrossRamp, CPG pay-in/payout, discovery, account balance, internal transfer):
# TYLT_TEST_INDIA_PAYIN_API_KEY=   TYLT_TEST_INDIA_PAYIN_API_SECRET=   optional TYLT_TEST_INDIA_PAYIN_BASE_URL=
# TYLT_TEST_INDIA_PAYOUT_API_KEY=  TYLT_TEST_INDIA_PAYOUT_API_SECRET=  optional TYLT_TEST_INDIA_PAYOUT_BASE_URL=
# TYLT_LIVE_INDIA_PAYIN_* / TYLT_LIVE_INDIA_PAYOUT_*  (same pattern for live)
#
# EU Open Banking (Prime Fiat pay-in / EUR bank payout):
# TYLT_TEST_EUR_PAYIN_API_KEY=     TYLT_TEST_EUR_PAYIN_API_SECRET=     optional TYLT_TEST_EUR_PAYIN_BASE_URL=
# TYLT_TEST_EUR_PAYOUT_API_KEY=    TYLT_TEST_EUR_PAYOUT_API_SECRET=    optional TYLT_TEST_EUR_PAYOUT_BASE_URL=
# TYLT_LIVE_EUR_PAYIN_* / TYLT_LIVE_EUR_PAYOUT_*
#
# Generic fallback (shared India+EU if lane vars unset):
# TYLT_TEST_PAYIN_API_KEY=   TYLT_TEST_PAYIN_API_SECRET=   optional TYLT_TEST_PAYIN_BASE_URL=
# TYLT_LIVE_PAYIN_API_KEY=   TYLT_LIVE_PAYIN_API_SECRET=   optional TYLT_LIVE_PAYIN_BASE_URL=
# TYLT_TEST_PAYOUT_API_KEY=  TYLT_TEST_PAYOUT_API_SECRET=  optional TYLT_TEST_PAYOUT_BASE_URL=
# TYLT_LIVE_PAYOUT_API_KEY=  TYLT_LIVE_PAYOUT_API_SECRET=  optional TYLT_LIVE_PAYOUT_BASE_URL=
#
# Legacy fallback (same key for both roles if PAYIN_/PAYOUT_ not set):
# TYLT_BASE_URL defaults to https://api.tylt.money when unset.
# TYLT_API_KEY=
# TYLT_API_SECRET=
# TYLT_BASE_URL=
# TYLT_TEST_API_KEY=
# TYLT_TEST_API_SECRET=
# TYLT_TEST_BASE_URL=
# TYLT_LIVE_API_KEY=
# TYLT_LIVE_API_SECRET=
# TYLT_LIVE_BASE_URL=
# H2H UPI create: isKYCNeeded defaults to 0. Set true only to require TL Pay end-user KYC on their flow.
# TYLT_H2H_REQUIRE_END_USER_KYC=false
#
# Legacy: hosted CrossRamp createInstance only (not merchant /v1 H2H): TYLT_ALLOW_KYC_BYPASS sends isKYCNeeded=0.
# TYLT_ALLOW_KYC_BYPASS=false

# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=  # Service role for backend (create signed upload URLs)
# KYC_STORAGE_BUCKET=kyc-documents  # Optional, default: kyc-documents

# Fraud & velocity (Bangladesh BDT payin/payout). 0 or unset = disabled for that limit.
# FRAUD_MAX_PAYINS_PER_HOUR=100
# FRAUD_MAX_PAYOUTS_PER_RECIPIENT_PER_DAY=10
# FRAUD_COOLING_PERIOD_HOURS=24
# FRAUD_MAX_PAYOUT_AMOUNT_PER_DAY_BDT=500000
# Manage blacklist via provider API: POST /provider/merchants/:id/blacklist (risk/super_admin role)
