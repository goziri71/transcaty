{
  "name": "transacty",
  "version": "0.1.0",
  "description": "B2B payment platform - domestic and cross-border pay-in and pay-out",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "validate": "npm run build && npm run security:sql",
    "security:sql": "tsx scripts/check-sql-safety.ts",
    "security:audit": "npm audit --audit-level=high",
    "security:check": "npm run security:sql && npm run security:audit",
    "start": "node dist/src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx scripts/db-check.ts",
    "db:backfill-slugs": "tsx scripts/backfill-merchant-slugs.ts",
    "db:migrate-merchant-markets": "tsx scripts/migrate-merchant-markets.ts",
    "db:migrate-provider-session-version": "tsx scripts/migrate-provider-session-version.ts",
    "db:push": "drizzle-kit push",
    "db:seed-merchant": "tsx scripts/seed-merchant.ts",
    "db:seed-portal-user": "tsx scripts/seed-portal-user.ts",
    "db:studio": "drizzle-kit studio",
    "encrypt": "tsx scripts/encrypt.ts",
    "payok:test": "tsx scripts/payok-test.ts",
    "payok:env-check": "tsx scripts/payok-env-check.ts",
    "payok:key-check": "tsx scripts/payok-key-check.ts",
    "payok:platform-key-check": "tsx scripts/payok-platform-key-check.ts",
    "test": "node --import tsx --test tests/lib/*.test.ts tests/domestic/*.test.ts tests/operations/*.test.ts tests/integration/*.test.ts services/integrations/tylt/*.test.ts services/integrations/tekko/*.test.ts",
    "test:unit": "node --import tsx --test tests/lib/*.test.ts services/integrations/tylt/*.test.ts services/integrations/tekko/*.test.ts",
    "test:integration": "node --import tsx --test tests/domestic/*.test.ts tests/operations/*.test.ts tests/integration/*.test.ts",
    "test:tylt": "node --import tsx --test services/integrations/tylt/*.test.ts",
    "test:tekko": "node --import tsx --test services/integrations/tekko/*.test.ts",
    "tekko:proxy-check": "tsx scripts/tekko-proxy-check.ts",
    "tekko:ngn-entitlement-check": "tsx scripts/tekko-ngn-entitlement-check.ts",
    "zepto:test": "tsx scripts/zepto-test.ts"
  },
  "keywords": [
    "payment",
    "b2b",
    "pay-in",
    "pay-out"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.1.0",
    "@supabase/supabase-js": "^2.99.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.3",
    "otplib": "^13.4.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.0.0",
    "prom-client": "^15.1.3",
    "undici": "^6.28.0",
    "zeptomail": "^7.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
